*.db-wal

# Secret — diinjeksi saat runtime via env_file, jangan ikut ke layer image
.env
.env.local

# Tidak relevan untuk build
.git
.gitignore
.claude
logs
ecosystem.config.cjs
deploy
*.md
Dockerfile
.dockerignore
compose.yml
.DS_Store
*.log
